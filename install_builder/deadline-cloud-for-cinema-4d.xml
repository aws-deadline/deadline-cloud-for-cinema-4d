<component>
    <name>deadline_cloud_for_cinema_4d</name>
    <description>Deadline Cloud for Cinema 4D 2024-2025</description>
    <detailedDescription>Cinema 4D plugin for submitting jobs to AWS Deadline Cloud. Compatible with Cinema 4D 2024/2025</detailedDescription>
    <canBeEdited>1</canBeEdited>
    <selected>0</selected>
    <show>1</show>
    <folderList>
        <folder>
            <description>Cinema4D Deadline Cloud Extension</description>
            <destination>${installdir}/tmp/c4d_deps</destination>
            <name>cinema4dextension</name>
            <platforms>all</platforms>
            <distributionFileList>
                <distributionFile>
                    <origin>../deadline_cloud_extension/DeadlineCloud.pyp</origin>
                </distributionFile>
            </distributionFileList>
        </folder>
        <folder>
            <description>Dependency Files</description>
             <destination>${installdir}/tmp/c4d_deps</destination>
             <name>c4ddeps</name>
             <platforms>all</platforms>
             <distributionFileList>
                 <distributionDirectory allowWildcards="1">
                     <origin>../dependency_bundle</origin>
                 </distributionDirectory>
             </distributionFileList>
        </folder>
        <folder>
            <description>Cinema 4D submitter installation directory</description>
            <destination>${cinema_4d_submitter_installdir}</destination>
            <name>cinema4d</name>
            <platforms>all</platforms>
            <distributionFileList>
                <distributionDirectory allowWildcards="1">
                    <origin>../src/*</origin>
                    <filterEvaluationLogic>or</filterEvaluationLogic>
                    <onPackingFilterList>
                        <fileNameFilter pattern="*/deadline/cinema4d_submitter/*" logic="matches" patternType="glob"/>
                    </onPackingFilterList>
                </distributionDirectory>
            </distributionFileList>
        </folder>
    </folderList>
    <initializationActionList>
        <if>
            <conditionRuleList>
                <compareText>
                    <logic>does_not_contain</logic>
                    <text>${platform_name}</text>
                    <value>linux</value>
                </compareText>
            </conditionRuleList>
            <actionList>
                <setInstallerVariable name="all_components" value="${all_components} deadline_cloud_for_cinema_4d" />
            </actionList>
            <elseActionList>
                <setInstallerVariable name="component(deadline_cloud_for_cinema_4d).show" value="0"/>
            </elseActionList>
        </if>
    </initializationActionList>
    <parameterList>
        <stringParameter name="deadline_cloud_for_cinema_4d_summary" ask="0" cliOptionShow="0">
            <value>Deadline Cloud for Cinema 4D
- Compatible with Cinema 4D 2024/2025
- Installs the integrated Cinema 4D submitter to the installation directory
- Registers the extension with Cinema 4D by setting the g_additionalModulePath
- Sets the C4DPYTHONPATH311 to retrieve deadline modules on Windows. 
- Copies the plugin file to Cinema 4D user install directories.
            </value>
        </stringParameter>
    </parameterList>
    <readyToInstallActionList>
        <if>
            <conditionRuleList>
                <isTrue value="${individual_install}"/>
            </conditionRuleList>
            <actionList>
                <setInstallerVariable name="cinema_4d_submitter_installdir" value="${installdir}"/>
            </actionList>
            <elseActionList>
                <setInstallerVariable name="cinema_4d_submitter_installdir" value="${installdir}/Submitters/Cinema4D"/>
            </elseActionList>
        </if>
    </readyToInstallActionList>
    <postInstallationActionList>
        <unzip>
            <destinationDirectory>${cinema_4d_submitter_installdir}</destinationDirectory>
            <zipFile>${installdir}/tmp/c4d_deps/dependency_bundle/deadline_cloud_for_cinema_4d_submitter-deps.zip</zipFile>
        </unzip>
        
        <!-- Platform specific actions -->
        <if>
            <conditionRuleList>
                <platformTest type="windows"/>
            </conditionRuleList>
            <actionList>
                <!-- Windows-specific actions -->
                <createDirectory>
                    <path>${cinema_4d_submitter_installdir}/cinema_4d_plugins</path>
                    <ruleList>
                        <fileTest condition="not_exists" path="${cinema_4d_submitter_installdir}/cinema_4d_plugins"/>
                    </ruleList>
                </createDirectory>
                <copyFile>
                    <destination>${cinema_4d_submitter_installdir}/cinema_4d_plugins/DeadlineCloud.pyp</destination>
                    <origin>${installdir}/tmp/c4d_deps/DeadlineCloud.pyp</origin>
                </copyFile>
                <fnAddPathEnvironmentVariable>
                    <progressText>Setting C4DPYTHONPATH311</progressText>
                    <name>C4DPYTHONPATH311</name>
                    <value>${cinema_4d_submitter_installdir}</value>
                    <scope>${installscope}</scope>
                    <insertAt>end</insertAt>
                </fnAddPathEnvironmentVariable>
                <fnAddPathEnvironmentVariable>
                    <progressText>Setting g_additionalModulePath</progressText>
                    <name>g_additionalModulePath</name>
                    <value>${cinema_4d_submitter_installdir}/cinema_4d_plugins</value>
                    <scope>${installscope}</scope>
                    <insertAt>end</insertAt>
                </fnAddPathEnvironmentVariable>
            </actionList>
            <elseActionList>
                <!-- MacOS-specific actions -->
                <!--We need to do this because Mac OS env variables don't affect GUI applications-->
                <runProgram>
                    <program>bash</program>
                    <programArguments>-c "
                        # Replace installation path in plugin file
                        sed -i '' 's|C4D_Submitter_Installation_Dir_To_Replace|${cinema_4d_submitter_installdir}|g' '${installdir}/tmp/c4d_deps/DeadlineCloud.pyp'

                        # Find and process Cinema 4D 2024 and 2025 directories
                        for version in 2024 2025; do
                            find \"\$HOME/Library/Preferences/Maxon\" -type d -name \"Maxon Cinema 4D \$version\_*\" -maxdepth 1 | while read -r dir; do
                                if [ -n \"\$dir\" ]; then
                                    plugin_dir=\"\$dir/plugins\"
                                    mkdir -p \"\$plugin_dir\"
                                    cp '${installdir}/tmp/c4d_deps/DeadlineCloud.pyp' \"\$plugin_dir/DeadlineCloud.pyp\"
                                    echo \"Copied plugin to \$plugin_dir\"
                                fi
                            done
                        done
                    "</programArguments>
                </runProgram>
            </elseActionList>
        </if>
        
        <deleteFile>
            <path>${installdir}/tmp/c4d_deps</path>
        </deleteFile>
    </postInstallationActionList>
    <shouldPackRuleList>
        <compareText>
               <logic>does_not_contain</logic>
               <text>${platform_name}</text>
               <value>linux</value>
        </compareText>
    </shouldPackRuleList>
    <preUninstallationActionList>
        <if>
            <conditionRuleList>
                <platformTest type="osx"/>
            </conditionRuleList>
            <actionList>
                <runProgram>
                    <program>bash</program>
                    <programArguments>-c "
                        # Handle uninstallation for both Cinema 4D 2024 and 2025
                        for version in 2024 2025; do
                            find \"\$HOME/Library/Preferences/Maxon\" -name 'DeadlineCloud.pyp' -path \"*/Maxon Cinema 4D \$version\_*/plugins/*\" | while read -r file; do
                                if [ -f \"\$file\" ]; then
                                    rm -f \"\$file\"
                                    echo \"Removed \$file\"
                                fi
                            done
                        done
                    "</programArguments>
                </runProgram>
            </actionList>
        </if>
    </preUninstallationActionList>
</component>
